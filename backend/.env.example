# OpenRouter API Configuration
# Get your free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=local_heuristic

# Demo Mode (Set true to seed sample historical sessions if database is empty)
DEMO_MODE=true

# App Settings
PROJECT_NAME="AI-Based Interview Simulator (HR Bot)"
DATABASE_URL=sqlite:///./interview_simulator.db
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scoring Weights (Must sum to 1.0 according to FYP proposal)
WEIGHT_CONFIDENCE=0.30
WEIGHT_CLARITY=0.30
WEIGHT_CONTENT=0.40
